# Supabase — copy from your project dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — from RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxx

# Sentry — from Sentry project settings
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Supabase Edge Function secrets (set via: supabase secrets set KEY=value)
# These never go in the client app:
# ANTHROPIC_API_KEY=sk-ant-xxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (auto-available in edge functions)
